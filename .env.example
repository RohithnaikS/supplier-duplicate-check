# --- SAP Ariba realm ---
ARIBA_REALM=

# --- Supplier Data API (SDA) client - from Ariba developer portal ---
# This is a DIFFERENT client id/secret than the External Approval API below.
ARIBA_SDA_OAUTH_TOKEN_URL=
ARIBA_SDA_CLIENT_ID=
ARIBA_SDA_CLIENT_SECRET=
ARIBA_SDA_API_BASE_URL=
# Application key from Manage > (this app) > "Application key" field on the
# developer portal -- required as the apiKey header on every SDA call, on
# top of the OAuth bearer token. Fill this in.
ARIBA_SDA_APP_KEY=

# --- External Approval API client - from Ariba developer portal ---
# Different client id/secret than the SDA client above.
ARIBA_APPROVAL_OAUTH_TOKEN_URL=
ARIBA_APPROVAL_CLIENT_ID=
ARIBA_APPROVAL_CLIENT_SECRET=
ARIBA_APPROVAL_API_BASE_URL=
# Application key for this app, same idea as ARIBA_SDA_APP_KEY above but for
# the External Approval API application. Fill this in.
ARIBA_APPROVAL_APP_KEY=

# --- Service account used only for the /action endpoint ---
# The External Approval API's /action endpoint additionally requires
# "user" and "passwordadapter" as query params, on top of the OAuth2
# bearer token from the Approval client above.
ARIBA_ACTION_SERVICE_USER=
ARIBA_ACTION_PASSWORD_ADAPTER=

# --- S/4 (parked for now -- duplicate check runs Ariba-only; not called by
#     duplicateCheckService.js until S4 matching is wired back in) ---
S4_VALIDATION_BASE_URL=https://your-s4-host/sap/opu/odata/sap/API_BUSINESS_PARTNER
S4_VALIDATION_CLIENT_ID=change-me
S4_VALIDATION_CLIENT_SECRET=change-me

# --- Questionnaire item labels used to pull the two answers we match on.
# Matched against the item's label text, not its internal correlation id. ---
SUPPLIER_LEGAL_NAME_LABEL=Full Legal Name of Supplier
SUPPLIER_CONTACT_EMAIL_LABEL=Email Address

# --- Polling: replaces the old "Ariba calls our webhook" model. The poller
# calls GET /pendingApprovables for ARIBA_ACTION_SERVICE_USER above, then
# for each pending task checks workspaceTitle (as a PREFIX match -- Ariba
# appends " for <supplier name>" at runtime) against every TARGET_WORKSPACE_TITLE*
# below before running the duplicate check. ---
POLL_ENABLED=true
POLL_INTERVAL_MS=30000
PENDING_APPROVABLES_DOCUMENT_TYPE=
TARGET_WORKSPACE_TITLE=Internal form for Sole, LLC, Partnership, Club & Society and Virtual Platforms

# --- Second questionnaire template (Workspace ID WS2856962909 / Document ID
# Doc2856962913). Confirmed live against a real task -- this form uses
# different field labels than form 1. ---
TARGET_WORKSPACE_TITLE_2=Supplier Registration Questionnaire for Site Vendors, Authority, Sponsorships, AC Payable, Virtual Platforms, Business Partners & Roaming Platforms
SUPPLIER_LEGAL_NAME_LABEL_2=Full Legal Name
SUPPLIER_CONTACT_EMAIL_LABEL_2=Contact Email Address

# --- Dry run: log the Approve/Deny/DenyWithResubmit that WOULD be called,
# without actually calling /action. Turn this off only once the answer
# correlation ids below are confirmed against a real submitted questionnaire.
DRY_RUN=false
